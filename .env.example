# Folder on the host where all data is stored (must exist; must be writable by AVN_UID/AVN_GID)
AVN_HOST_DATA_DIR=./data
AVN_UID=1000
AVN_GID=1000

# SQLite query scratch directory INSIDE the containers (on the disk-backed /data mount).
# Created and checked at startup. A custom path must also be on a writable disk mount.
SQLITE_TMPDIR=/data/sqlite-tmp

# Required: secret token for the admin API
AVN_ADMIN_TOKEN=

# Ports and the address they bind to (use 0.0.0.0 to listen on all interfaces)
AVN_BIND_HOST=127.0.0.1
AVN_INGEST_PORT=8100
AVN_ADMIN_PORT=8101

# Optional limits
AVN_REQUESTS_PER_MINUTE=120
# Seconds a slow dashboard answer is reused (0 turns it off). New events show up after this.
AVN_READ_CACHE_SECONDS=60
AVN_MAX_EXPORT_BYTES=268435456
# Where dashboards read events: legacy (raw events), facts (checked plain columns), or
# prepared (fresh worker answers with live facts fallback). See docs/analytics-pipeline.md.
AVN_ANALYTICS_READ_MODE=legacy

# Public collection address shown in the dashboard (e.g. https://analytics.example.com)
AVN_PUBLIC_INGEST_URL=

# Team access (optional). Leave empty to keep the single-user mode where every request is an admin.
# Put the Cloudflare Access application in front of the admin site, then fill in all of these:
# Zero Trust > Settings > Custom pages shows the team domain. The application's "Application
# Audience (AUD) Tag" is on that application's page under Access controls > Applications (the
# exact tab varies between dashboard versions; look for "Application Audience (AUD) Tag").
AVN_ACCESS_TEAM_DOMAIN=
AVN_ACCESS_AUDIENCE=
# This person is always an admin and can't be removed from the website.
AVN_ADMIN_EMAIL=
# Requests from your own network (no Cloudflare in between) count as the admin.
AVN_LAN_ADMIN=true

# NutBot: the in-dashboard assistant. It drives a local AI agent (claude, codex or opencode) over
# the Agent Client Protocol; the agent can only use this app's tools. Admins choose per workspace
# who may use it (Workspaces page). See README > NutBot for signing the agents in.
AVN_NUTBOT=true
AVN_NUTBOT_DEFAULT_HARNESS=claude
AVN_NUTBOT_DAILY_LIMIT=100
# Chats are kept on the server; 0 keeps them forever, otherwise older chats are removed.
AVN_NUTBOT_KEEP_DAYS=0
# Warn in the panel when an agent's allowance window (5 hours / week) is this % used.
AVN_NUTBOT_LIMIT_WARN=80
# Default and "cheap" model per agent, as the agent names them (the panel lists what it offers).
AVN_NUTBOT_CLAUDE_MODEL=sonnet
AVN_NUTBOT_CLAUDE_CHEAP_MODEL=haiku
AVN_NUTBOT_CODEX_MODEL=
AVN_NUTBOT_CODEX_CHEAP_MODEL=
AVN_NUTBOT_OPENCODE_MODEL=
AVN_NUTBOT_OPENCODE_CHEAP_MODEL=
# The adapters are built into the image. To use other builds, point these at them (path or glob):
# AVN_NUTBOT_CLAUDE_ACP, AVN_NUTBOT_CODEX_ACP, AVN_NUTBOT_OPENCODE_BIN; and AVN_NUTBOT_CLAUDE_BIN /
# AVN_NUTBOT_CODEX_BIN for a specific Claude Code / Codex CLI the adapters should run.
# AVN_NUTBOT_HOME moves the agents' sign-ins and transcripts out of data/nutbot/home.
# AVN_NUTBOT_TRUST_LOGINS=true skips the sign-in check (for sign-ins kept elsewhere, e.g. the keychain
# on a developer's Mac); the agent then reports a missing sign-in itself.
# Long-lived Claude subscription token from `claude setup-token` (alternative: sign in once inside
# the container, see README):
CLAUDE_CODE_OAUTH_TOKEN=

# Background analytics supervisor. Start/Stop in Settings persists after installation.
AVN_ANALYTICS_WORKER_DEFAULT_ENABLED=true
AVN_ANALYTICS_BATCH_ROWS=5000
AVN_ANALYTICS_REFRESH_SECONDS=10
AVN_ANALYTICS_FRESHNESS_SECONDS=60
AVN_ANALYTICS_ACTIVE_VIEWS=12
AVN_ANALYTICS_STORAGE_BYTES=268435456
