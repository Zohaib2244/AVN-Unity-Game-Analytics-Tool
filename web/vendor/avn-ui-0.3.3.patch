+    await user.type(screen.getByLabelText('Message NutBot'), 'W');
+    expect(onDraftChange).toHaveBeenLastCalledWith('W');
+    unmount();
+    render(panel({ embedded: true, draft: 'Why level 12', onDraftChange }));
+    expect(screen.getByLabelText('Message NutBot')).toHaveValue('Why level 12');
+    expect(screen.getByLabelText('NutBot').tagName).toBe('SECTION');
+  });
+  it('header actions sit beside New, and a view replaces the conversation but keeps the composer', () => {
+    render(panel({ messages, actions: <button type="button">History</button>, view: <p>Earlier chats</p> }));
+    expect(screen.getByRole('button', { name: 'History' })).toBeInTheDocument();
+    expect(screen.getByText('Earlier chats')).toBeInTheDocument();
+    expect(screen.queryByText('Level 12.')).toBeNull();
+    expect(screen.queryByText('Looking at')).toBeNull();
+    expect(screen.getByLabelText('Message NutBot')).toBeInTheDocument();
+  });
+  it('@ edits the context: a chip with options opens its choices, any other is left out or put back', async () => {
+    const user = userEvent.setup();
+    const onContext = vi.fn();
+    const chips = [
+      { id: 'game', label: 'Sand Smash', fixed: true },
+      { id: 'range', label: 'Sep 29 → Oct 28', kind: 'Dates', options: [{ id: '7', label: 'Last 7 days' }, { id: '30', label: 'Last 30 days' }], choice: '30' },
+      { id: 'page', label: 'Levels', kind: 'Page', off: true },
+    ];
+    render(panel({ context: chips, onContext }));
+    const box = screen.getByLabelText('Message NutBot');
+    await user.type(box, '@');
+    expect(screen.getByRole('option', { name: /Dates/ })).toBeInTheDocument();
+    expect(screen.getByRole('option', { name: /Levels · left out/ })).toBeInTheDocument();
+    await user.click(screen.getByRole('option', { name: /Dates/ }));
+    expect(screen.getByRole('option', { name: /Last 30 days/ })).toHaveTextContent('In use');
+    await user.click(screen.getByRole('option', { name: /Last 7 days/ }));
+    expect(onContext).toHaveBeenLastCalledWith('range', '7');
+    expect(box).toHaveValue('');
+    await user.type(box, '@');
+    await user.click(screen.getByRole('option', { name: /Page/ }));
+    expect(onContext).toHaveBeenLastCalledWith('page');
+  });
+  it('Escape closes the / list and the @ list', async () => {
+    const user = userEvent.setup();
+    render(panel({ commands: [{ name: '/digest', description: 'What players have been doing lately: habits, loops, unused features, changes · optional: a date range' }] }));
+    const box = screen.getByLabelText('Message NutBot');
+    await user.type(box, '/');
+    expect(screen.getByRole('listbox', { name: 'Commands' })).toBeInTheDocument();
+    await user.keyboard('{Escape}');
+    expect(screen.queryByRole('listbox')).toBeNull();
+    await user.clear(box);
+    await user.type(box, '/');
+    expect(screen.getByRole('listbox', { name: 'Commands' })).toBeInTheDocument();
+    (document.activeElement as HTMLElement).blur();
+    await user.keyboard('{Escape}');
+    expect(screen.queryByRole('listbox')).toBeNull();
+  });
+  it('leading header buttons come first and the close button can move into them', () => {
+    render(panel({ leading: <button type="button">Hide NutBot</button>, closeButton: false }));
+    expect(screen.getByRole('button', { name: 'Hide NutBot' })).toBeInTheDocument();
