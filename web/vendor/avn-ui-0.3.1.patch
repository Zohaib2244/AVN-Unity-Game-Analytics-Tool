+describe('dialog toast actions', () => {
+  it('restores data without closing its dialog', async () => {
+    function Example() {
+      const [open, setOpen] = useState(true);
+      const [hidden, setHidden] = useState(false);
+      const { toast } = useToast();
+      return <DialogShell open={open} onOpenChange={setOpen} title="Player details"><button onClick={() => {
+        setHidden(true);
+        toast({ title: 'Parameter hidden', action: { label: 'Undo', onClick: () => setHidden(false) } });
+      }}>Hide parameter</button>{hidden ? null : <span>score</span>}</DialogShell>;
+    }
+    const user = userEvent.setup();
+    render(<ToastProvider><Example /></ToastProvider>);
+    await user.click(screen.getByRole('button', { name: 'Hide parameter' }));
+    expect(screen.queryByText('score')).toBeNull();
+    const undo = screen.getByRole('button', { name: 'Undo', hidden: true });
+    fireEvent.pointerDown(undo);
+    fireEvent.click(undo);
+    expect(screen.getByRole('dialog', { name: 'Player details' })).toBeInTheDocument();
+    expect(screen.getByText('score')).toBeInTheDocument();
+  });
+});
+
+describe('fixed popovers', () => {
+  it('uses viewport coordinates when the app has scrolled, and follows its anchor', () => {
+    const anchor = createRef<HTMLButtonElement>();
+    const app = document.createElement('div');
+    app.getBoundingClientRect = () => ({ left: 0, top: -300, width: 1200 } as DOMRect);
+    let bottom = 140;
+    const { rerender } = render(<button ref={anchor}>Game</button>);
+    anchor.current!.getBoundingClientRect = () => ({ left: 20, bottom } as DOMRect);
+    rerender(<AppContainerProvider appEl={app}><button ref={anchor}>Game</button><Popover open position="fixed" anchor={anchor} onClose={() => {}}>Games</Popover></AppContainerProvider>);
+    // The wrapper changes the button's identity, so replace its measurement and dispatch a scroll.
+    anchor.current!.getBoundingClientRect = () => ({ left: 20, bottom } as DOMRect);
+    fireEvent.scroll(document);
+    expect(screen.getByRole('dialog').style.getPropertyValue('--y')).toBe('146px');
+    bottom = 100;
+    fireEvent.scroll(document);
+    expect(screen.getByRole('dialog').style.getPropertyValue('--y')).toBe('106px');
+  });
+});
